---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;

const statusIcons = {
  seedling: "🌱 Seedling",
  budding: "🌿 Budding",
  evergreen: "🌳 Evergreen"
};
---

<BaseLayout pageTitle={frontmatter.title}>
  <article>
   
    <p style="color: #a1a1aa; font-size: 0.9em;">
        <em>Published on: {frontmatter.date} | Status: {statusIcons[frontmatter.status]}</em>
    </p>
    
    <hr /> 
    
    <slot />
  </article>
</BaseLayout>