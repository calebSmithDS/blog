---
const { pageTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | My Digital Garden</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
      </nav>
    </header>

    <main>
      <h1>{pageTitle}</h1>
      
      
      <slot />
    </main>

    <footer>
      <p>© 2026 My Digital Garden</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #ffffff;       
    --text-color: #18181b;     
    --header-color: #000000;   
    --link-color: #6c40d6;     
    --link-hover: #4a2b99;
    --code-bg: #f4f4f5;
    --code-block-bg: #e4e4e7;
  }

  /* 2. Define System Dark Mode Overrides */
  @media (prefers-color-scheme: dark) {
    :root {
      --bg-color: #18181b;     
      --text-color: #e4e4e7;   
      --header-color: #ffffff; 
      --link-color: #a882ff;   
      --link-hover: #c4a7ff;
      --code-bg: #27272a;
      --code-block-bg: #09090b;
    }
  }

  body {
    /* layout */
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
    max-width: 750px;
    margin: 40px auto;

    /* colors */
    background-color: var(--bg-color);
    color: var(--text-color);

    /* typography */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    font-size: 16px;

  }

   h1, h2, h3, h4 {
      color: var(--header-color);
      font-weight: 600;
    }

  a {
    color: (--link-color);
    text-decoration: none;
  }

  a:hover {
    color: (--link-hover);
    text-decoration: underline;
  }

  /* essay style */
  /* --- Markdown Content Styling --- */

  /* 1. Blockquotes (For citing literature or concepts) */
    blockquote {
      border-left: 3px solid #a882ff; 
      margin: 1.5em 0;
      padding-left: 1em;
      color: #a1a1aa; 
      font-style: italic;
    }

    /* 2. Inline Code (For single commands or variables in a sentence) */
    code {
      font-family: ui-monospace, SFMono-Regular, Consolas, Menlo, monospace;
      background-color: var(--code-bg); 
      padding: 0.2em 0.4em;
      border-radius: 4px;
      font-size: 0.9em;
    }

    /* 3. Code Blocks (For multi-line script implementations) */
    pre {
      background-color: var(--code-block-bg); /* A darker well to make the code pop */
      padding: 16px;
      border-radius: 8px;
      overflow-x: auto; /* Adds a scrollbar if a line gets too long on mobile */
      margin: 1.5em 0;
    }

    /* Reset the inline code style when it sits inside a full code block */
    pre code {
      background-color: transparent;
      padding: 0;
      color: var(--text-color);
    }

    /* 4. Lists (Bullet points and numbered lists) */
    ul, ol {
      padding-left: 1.5em;
      margin-bottom: 1.5em;
    }

    li {
      margin-bottom: 0.5em;
    }
</style>