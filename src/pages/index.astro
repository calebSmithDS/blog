---
import BaseLayout from '../layouts/BaseLayout.astro';

const allEssays = Object.values(import.meta.glob('./essays/*.md', { eager: true }));
---

<BaseLayout pageTitle="Essay Directory">
  <h2>Selected Essays</h2>
  
  <ul>
    {allEssays.map((essay) => (
      <li>
        <a href={essay.url}>{essay.frontmatter.title}</a> 
        <span style="color: #666; font-size: 0.9em;"> — {essay.frontmatter.date}</span>
      </li>
    ))}
  </ul>
</BaseLayout>